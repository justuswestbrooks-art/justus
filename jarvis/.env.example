# Copy to jarvis/.env and fill in what you have. Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=

# Finding local businesses without websites (Google Places API "New")
GOOGLE_PLACES_API_KEY=

# Shopify: your-store (or your-store.myshopify.com) + Admin API access token with read_orders
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2025-10

# YouTube Data API v3 key + your channel ID (starts with UC)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional
# JARVIS_EFFORT=medium   # low | medium | high
